#!/bin/sh
# Install root-owned (0755) and pass this path as yay's sudoflags while using
# /usr/bin/sudo as yay's sudo_bin. The sudo rule should allow only this exact
# executable for aur_user.
set -efu
invocation=$*
reject() {
    status=$1
    shift
    printf 'pacman-updater: rejected command: %s\n' "$invocation" >&2
    printf 'pacman-updater: %s\n' "$*" >&2
    exit "$status"
}
case "${1-}" in
    -U|--upgrade|-D|--database|-S|--sync|-Sc|-Scc)
        operation=$1
        shift
        ;;
    pacman|/usr/bin/pacman)
        [ "$#" -ge 2 ] || reject 64 'pacman operation is missing'
        operation=$2
        shift 2
        ;;
    *)
        reject 64 "unsupported command: ${1-}"
        ;;
esac
validate_upgrade_args() (
    packages=0
    while [ "$#" -gt 0 ]; do
        case "$1" in
            -d|-dd|-p|-pp|-v|-w|--asdeps|--asexplicit|--needed|--noconfirm|--confirm|--nodeps|--dbonly|--noprogressbar|--noscriptlet|--print|--downloadonly|--disable-download-timeout|--disable-sandbox|--disable-sandbox-filesystem|--disable-sandbox-syscalls|--) ;;
            --assume-installed|--ignore|--ignoregroup|--overwrite|--print-format|--color)
                [ "$#" -ge 2 ] && [ -n "$2" ] || {
                    reject 64 "option requires an argument: $1"
                }
                shift
                ;;
            --config)
                [ "$#" -ge 2 ] && [ "$2" = /etc/pacman.conf ] || {
                    reject 64 'only /etc/pacman.conf is permitted'
                }
                shift
                ;;
            --*) reject 64 "unsupported option: $1";;
            /*)
                [ -f "$1" ] || {
                    reject 66 "package is not a regular file: $1"
                }
                packages=$((packages + 1))
                ;;
            *) reject 64 'package path must be absolute';;
        esac
        shift
    done
    [ "$packages" -gt 0 ] || {
        reject 64 'at least one package is required'
    }
)
validate_database_args() (
    targets=0
    while [ "$#" -gt 0 ]; do
        case "$1" in
            -q|-v|--quiet|--verbose|--noconfirm|--confirm|--debug|--asdeps|--asexplicit|--check|--) ;;
            --color)
                [ "$#" -ge 2 ] && [ "$2" = always -o "$2" = auto -o "$2" = never ] || {
                    reject 64 'color must be always, auto, or never'
                }
                shift
                ;;
            --config)
                [ "$#" -ge 2 ] && [ "$2" = /etc/pacman.conf ] || {
                    reject 64 'only /etc/pacman.conf is permitted'
                }
                shift
                ;;
            --*) reject 64 "unsupported option: $1";;
            -*) reject 64 "unsupported option: $1";;
            *) targets=$((targets + 1));;
        esac
        shift
    done
    [ "$targets" -gt 0 ] || {
        reject 64 'at least one package is required'
    }
)
validate_clean_args() (
    clean=0
    while [ "$#" -gt 0 ]; do
        case "$1" in
            -c|-cc|--clean|--noconfirm|--confirm|--debug|--verbose|--quiet|--noprogressbar|--disable-download-timeout|--disable-sandbox|--disable-sandbox-filesystem|--disable-sandbox-syscalls|--)
                case "$1" in
                    -c|-cc|--clean) clean=1;;
                esac
                ;;
            --color)
                [ "$#" -ge 2 ] && [ "$2" = always -o "$2" = auto -o "$2" = never ] || {
                    reject 64 'color must be always, auto, or never'
                }
                shift
                ;;
            --config)
                [ "$#" -ge 2 ] && [ "$2" = /etc/pacman.conf ] || {
                    reject 64 'only /etc/pacman.conf is permitted'
                }
                shift
                ;;
            --*) reject 64 "unsupported option: $1";;
            -*) reject 64 "unsupported option: $1";;
            *) reject 64 'clean operation does not accept targets';;
        esac
        shift
    done
    [ "$clean" -eq 1 ] || {
        reject 64 'clean operation is required'
    }
)
case "$operation" in
    -U|--upgrade)
        validate_upgrade_args "$@"
        exec /usr/bin/pacman -U --noconfirm "$@"
        ;;
    -D|--database)
        validate_database_args "$@"
        exec /usr/bin/pacman -D "$@"
        ;;
    -S|--sync|-Sc|-Scc)
        case "$operation" in
            -Sc|-Scc)
                validate_clean_args -c "$@"
                ;;
            *)
                validate_clean_args "$@"
                ;;
        esac
        exec /usr/bin/pacman "$operation" --noconfirm "$@"
        ;;
    *)
        reject 64 "unsupported pacman operation: $operation"
        ;;
esac
